# Netlify Environment Variables
# These need to be added in Netlify Dashboard → Site Settings → Environment Variables

# Netlify Personal Access Token (for fetching and deleting form submissions)
# Get this from: Netlify Dashboard → User Settings → Applications → New access token
NETLIFY_API_TOKEN=your_netlify_token_here

# GitHub Personal Access Token (for committing approved events to GitHub)
# Get this from: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Required scopes: repo (Full control of private repositories)
GITHUB_TOKEN=your_github_token_here

# Your Netlify Site ID (API ID)
# Get this from: Netlify Dashboard → Your Site → Site Settings → Site information → API ID
CUSTOM_SITE_ID=your_site_id_here

# GitHub repository info (optional, defaults to shulajaron-star/oregon-events-calendar)
GITHUB_OWNER=shulajaron-star
GITHUB_REPO=oregon-events-calendar
